<apex:page showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0" applyHtmlTag="true" applyBodyTag="false">
    <head>
        <title>GenAI Assistant Portal</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
        <apex:includeLightning />
        <style>
            *, *::before, *::after {
                box-sizing: border-box;
            }
            html, body {
                margin: 0;
                padding: 0;
                width: 100vw;
                height: 100vh;
                height: 100dvh;
                min-height: 100vh;
                background-color: #f8fafc;
                color: #0f172a;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                overflow: hidden;
            }
            #genai-vf-container {
                position: relative;
                width: 100vw;
                height: 100vh;
                height: 100dvh;
                display: flex;
                flex-direction: column;
                flex: 1 1 100%;
                overflow: hidden;
            }
            #lightning-chat-mount {
                width: 100%;
                height: 100%;
                height: 100vh;
                height: 100dvh;
                flex: 1 1 100%;
                display: flex;
                flex-direction: column;
                min-height: 0;
                overflow: hidden;
                z-index: 1;
            }
            #lightning-chat-mount > * {
                width: 100% !important;
                height: 100% !important;
                flex: 1 1 100% !important;
                display: flex !important;
                flex-direction: column !important;
                min-height: 0 !important;
                overflow: hidden !important;
            }
            c-gen-a-i-chat {
                width: 100% !important;
                height: 100% !important;
                flex: 1 1 100% !important;
                display: flex !important;
                flex-direction: column !important;
                min-height: 0 !important;
            }

            /* ==========================================================================
               FULL SCREEN LIGHT SKELETON LOADING STATE
               ========================================================================== */
            .vf-skeleton-container {
                position: absolute;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                height: 100dvh;
                background: #f8fafc;
                display: flex;
                flex-direction: column;
                z-index: 999;
                transition: opacity 0.35s ease-out;
                pointer-events: auto;
                overflow: hidden;
            }

            /* Shimmer Animation */
            @keyframes skeletonShimmer {
                0% {
                    background-position: -200% 0;
                }
                100% {
                    background-position: 200% 0;
                }
            }

            .sk-shimmer {
                background: linear-gradient(
                    90deg,
                    #f1f5f9 0%,
                    #e2e8f0 50%,
                    #f1f5f9 100%
                );
                background-size: 200% 100%;
                animation: skeletonShimmer 1.8s ease-in-out infinite;
                border-radius: 8px;
            }

            /* Top Status Floating Pill */
            .sk-status-banner {
                position: absolute;
                top: 14px;
                left: 50%;
                transform: translateX(-50%);
                z-index: 10;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 6px 16px;
                background: rgba(255, 255, 255, 0.95);
                border: 1px solid #cbd5e1;
                border-radius: 9999px;
                backdrop-filter: blur(8px);
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
                font-size: 12px;
                font-weight: 500;
                color: #1e293b;
                letter-spacing: -0.01em;
            }
            .sk-pulse-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #4f46e5;
                box-shadow: 0 0 10px rgba(79, 70, 229, 0.5);
                animation: pulseGlow 1.4s ease-in-out infinite;
            }
            .sk-pulse-dot.warning {
                background: #f59e0b;
                box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
            }
            @keyframes pulseGlow {
                0%, 100% { opacity: 0.4; transform: scale(0.9); }
                50% { opacity: 1; transform: scale(1.15); }
            }

            /* Skeleton Header / Toolbar */
            .sk-header {
                height: 58px;
                border-bottom: 1px solid #e2e8f0;
                background: rgba(255, 255, 255, 0.95);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 20px;
                flex-shrink: 0;
            }
            .sk-hdr-left {
                display: flex;
                align-items: center;
                gap: 12px;
            }
            .sk-hdr-right {
                display: flex;
                align-items: center;
                gap: 10px;
            }
            .sk-pill-btn {
                height: 32px;
                width: 82px;
                border-radius: 20px;
            }
            .sk-pill-btn.sm {
                width: 70px;
            }
            .sk-title-bar {
                height: 22px;
                width: 140px;
                border-radius: 6px;
                margin-left: 6px;
            }
            .sk-circle-btn {
                width: 32px;
                height: 32px;
                border-radius: 50%;
            }
            .sk-user-badge {
                height: 32px;
                width: 110px;
                border-radius: 18px;
            }

            /* Skeleton Subchips Bar */
            .sk-subbar {
                height: 44px;
                border-bottom: 1px solid #e2e8f0;
                background: #ffffff;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0 20px;
                flex-shrink: 0;
            }
            .sk-chip {
                height: 28px;
                border-radius: 14px;
            }
            .sk-chip.w-model { width: 140px; }
            .sk-chip.w-persona { width: 130px; }
            .sk-chip.w-quota { width: 110px; }
            .sk-chip.w-incognito { width: 95px; }

            /* Skeleton Chat Body */
            .sk-body {
                flex: 1 1 100%;
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                padding: 24px 28px;
                gap: 20px;
                background: #f8fafc;
                overflow: hidden;
            }
            .sk-msg-row {
                display: flex;
                flex-direction: column;
                gap: 8px;
                max-width: 720px;
                width: 100%;
            }
            .sk-msg-row.ai {
                align-self: flex-start;
            }
            .sk-msg-row.user {
                align-self: flex-end;
                align-items: flex-end;
            }
            .sk-ai-header {
                display: flex;
                align-items: center;
                gap: 10px;
            }
            .sk-ai-orb {
                width: 26px;
                height: 26px;
                border-radius: 8px;
            }
            .sk-ai-name {
                height: 14px;
                width: 110px;
                border-radius: 4px;
            }
            .sk-bubble {
                padding: 16px 20px;
                border-radius: 18px;
                display: flex;
                flex-direction: column;
                gap: 10px;
                width: 100%;
            }
            .sk-msg-row.ai .sk-bubble {
                background: #ffffff;
                border: 1px solid #e2e8f0;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
                border-top-left-radius: 4px;
            }
            .sk-msg-row.user .sk-bubble {
                background: #eef2ff;
                border: 1px solid #c7d2fe;
                box-shadow: 0 2px 8px rgba(99, 102, 241, 0.08);
                border-top-right-radius: 4px;
                max-width: 440px;
            }
            .sk-line {
                height: 12px;
                border-radius: 4px;
            }
            .sk-line.w-full { width: 100%; }
            .sk-line.w-90 { width: 90%; }
            .sk-line.w-80 { width: 80%; }
            .sk-line.w-65 { width: 65%; }
            .sk-line.w-45 { width: 45%; }

            /* Skeleton Input Dock */
            .sk-dock {
                height: 78px;
                border-top: 1px solid #e2e8f0;
                background: rgba(255, 255, 255, 0.95);
                display: flex;
                align-items: center;
                padding: 0 24px;
                gap: 12px;
                flex-shrink: 0;
            }
            .sk-input-card {
                flex: 1;
                height: 48px;
                border-radius: 24px;
                background: #f1f5f9;
                border: 1px solid #cbd5e1;
                display: flex;
                align-items: center;
                padding: 0 16px;
                gap: 12px;
            }
            .sk-input-prompt {
                height: 14px;
                width: 220px;
                border-radius: 4px;
            }
            .sk-send-btn {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                flex-shrink: 0;
            }

            /* Fallback Error Card */
            .vf-error-card {
                margin: auto;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 14px;
                padding: 32px 36px;
                background: #ffffff;
                border: 1px solid #fecaca;
                border-radius: 16px;
                max-width: 460px;
                text-align: center;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            }
            .vf-error-icon {
                font-size: 32px;
            }
            .vf-error-title {
                margin: 0;
                font-size: 18px;
                font-weight: 700;
                color: #dc2626;
            }
            .vf-error-msg {
                margin: 0;
                font-size: 13.5px;
                color: #475569;
                line-height: 1.5;
            }
            .vf-retry-btn {
                margin-top: 8px;
                padding: 9px 22px;
                background: #4f46e5;
                color: #ffffff;
                font-size: 13px;
                font-weight: 600;
                border: none;
                border-radius: 8px;
                cursor: pointer;
                transition: background 0.2s ease;
            }
            .vf-retry-btn:hover {
                background: #4338ca;
            }
        </style>
    </head>
    <body>
        <div id="genai-vf-container">
            <!-- MODERN ENTERPRISE SKELETON LOADING UI -->
            <div id="genai-loader" class="vf-skeleton-container">
                <div class="sk-status-banner" id="skeleton-status-pill">
                    <span class="sk-pulse-dot"></span>
                    <span>Initializing GenAI Workspace...</span>
                </div>

                <!-- Skeleton Header -->
                <header class="sk-header">
                    <div class="sk-hdr-left">
                        <div class="sk-shimmer sk-pill-btn"></div>
                        <div class="sk-shimmer sk-pill-btn sm"></div>
                        <div class="sk-shimmer sk-pill-btn"></div>
                        <div class="sk-shimmer sk-title-bar"></div>
                    </div>
                    <div class="sk-hdr-right">
                        <div class="sk-shimmer sk-circle-btn"></div>
                        <div class="sk-shimmer sk-user-badge"></div>
                        <div class="sk-shimmer sk-circle-btn"></div>
                    </div>
                </header>

                <!-- Skeleton Chips Bar -->
                <div class="sk-subbar">
                    <div class="sk-shimmer sk-chip w-model"></div>
                    <div class="sk-shimmer sk-chip w-persona"></div>
                    <div class="sk-shimmer sk-chip w-quota"></div>
                    <div class="sk-shimmer sk-chip w-incognito"></div>
                </div>

                <!-- Skeleton Conversation Body -->
                <div class="sk-body">
                    <!-- AI Assistant Skeleton Message -->
                    <div class="sk-msg-row ai">
                        <div class="sk-ai-header">
                            <div class="sk-shimmer sk-ai-orb"></div>
                            <div class="sk-shimmer sk-ai-name"></div>
                        </div>
                        <div class="sk-bubble">
                            <div class="sk-shimmer sk-line w-full"></div>
                            <div class="sk-shimmer sk-line w-90"></div>
                            <div class="sk-shimmer sk-line w-80"></div>
                            <div class="sk-shimmer sk-line w-65"></div>
                        </div>
                    </div>

                    <!-- User Skeleton Message -->
                    <div class="sk-msg-row user">
                        <div class="sk-bubble">
                            <div class="sk-shimmer sk-line w-full"></div>
                            <div class="sk-shimmer sk-line w-65"></div>
                        </div>
                    </div>

                    <!-- Incoming AI Response Skeleton -->
                    <div class="sk-msg-row ai">
                        <div class="sk-ai-header">
                            <div class="sk-shimmer sk-ai-orb"></div>
                            <div class="sk-shimmer sk-ai-name"></div>
                        </div>
                        <div class="sk-bubble">
                            <div class="sk-shimmer sk-line w-full"></div>
                            <div class="sk-shimmer sk-line w-90"></div>
                            <div class="sk-shimmer sk-line w-45"></div>
                        </div>
                    </div>
                </div>

                <!-- Skeleton Input Dock -->
                <footer class="sk-dock">
                    <div class="sk-input-card">
                        <div class="sk-shimmer sk-input-prompt"></div>
                    </div>
                    <div class="sk-shimmer sk-send-btn"></div>
                </footer>
            </div>

            <!-- Lightning Component Mount Point -->
            <div id="lightning-chat-mount"></div>
        </div>

        <script>
            (function() {
                var recordIdFromUrl = '{!$CurrentPage.parameters.id}' || '';
                var appParams = {};
                if (recordIdFromUrl) {
                    appParams.recordId = recordIdFromUrl;
                }

                var safetyTimer = setTimeout(function() {
                    var statusBanner = document.getElementById("skeleton-status-pill");
                    if (statusBanner) {
                        statusBanner.innerHTML = '<span class="sk-pulse-dot warning"></span><span>Establishing secure connection to AI engine...</span>';
                    }
                }, 4000);

                $Lightning.use("c:genAIChatApp", function() {
                    $Lightning.createComponent(
                        "c:genAIChat",
                        appParams,
                        "lightning-chat-mount",
                        function(component, status, errorMessage) {
                            clearTimeout(safetyTimer);
                            var loader = document.getElementById("genai-loader");
                            if (status === "SUCCESS") {
                                if (loader) {
                                    loader.style.opacity = "0";
                                    setTimeout(function() {
                                        loader.style.display = "none";
                                    }, 350);
                                }
                                console.log("GenAI Chat component mounted successfully via Visualforce Page.");
                            } else {
                                if (loader) {
                                    loader.innerHTML = '<div class="vf-error-card">' +
                                        '<div class="vf-error-icon">⚠️</div>' +
                                        '<h3 class="vf-error-title">Unable to Load GenAI Chat</h3>' +
                                        '<p class="vf-error-msg">' + (errorMessage || 'Please check Lightning Out configuration or guest user profile permissions.') + '</p>' +
                                        '<button onclick="window.location.reload()" class="vf-retry-btn">Try Again</button>' +
                                        '</div>';
                                }
                                console.error("Error creating GenAI Chat component:", errorMessage);
                            }
                        }
                    );
                });
            })();
        </script>
    </body>
</apex:page>
