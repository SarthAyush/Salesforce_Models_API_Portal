<apex:page showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0">
<html>
<head>
    <title>Connecting Salesforce Org...</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: #f8fafc;
            color: #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }
        .auth-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 32px;
            max-width: 420px;
            text-align: center;
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.1);
        }
        .spinner {
            width: 40px;
            height: 40px;
            border: 3px solid #e2e8f0;
            border-top: 3px solid #4f46e5;
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
            margin: 0 auto 16px auto;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        h2 { font-size: 1.15rem; margin-bottom: 8px; color: #1e293b; }
        p { font-size: 0.875rem; color: #64748b; margin: 0; }
        .error-state { color: #ef4444; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="spinner" id="loading-spinner"></div>
        <h2 id="status-title">Authenticating Salesforce Org...</h2>
        <p id="status-desc">Transferring credentials to your GenAI workspace. This window will close automatically.</p>
    </div>

    <script>
        (function() {
            try {
                // Parse both Hash (User-Agent flow) and Query params (Web Server flow)
                var hash = window.location.hash.substring(1);
                var search = window.location.search.substring(1);
                var params = {};

                function parseQuery(queryString) {
                    if (!queryString) return;
                    var pairs = queryString.split('&');
                    for (var i = 0; i < pairs.length; i++) {
                        var pair = pairs[i].split('=');
                        if (pair.length === 2) {
                            params[decodeURIComponent(pair[0])] = decodeURIComponent(pair[1]);
                        }
                    }
                }

                parseQuery(hash);
                parseQuery(search);

                var payload = {
                    type: 'SALESFORCE_ORG_AUTH_RESPONSE',
                    accessToken: params.access_token || null,
                    instanceUrl: params.instance_url || null,
                    refreshToken: params.refresh_token || null,
                    id: params.id || null,
                    code: params.code || null,
                    state: params.state || null,
                    error: params.error || null,
                    errorDescription: params.error_description || null
                };

                if (window.opener) {
                    window.opener.postMessage(payload, '*');
                    document.getElementById('status-title').textContent = payload.error ? 'Authentication Error' : 'Connection Successful!';
                    if (payload.error) {
                        document.getElementById('status-title').className = 'error-state';
                        document.getElementById('status-desc').textContent = payload.errorDescription || payload.error;
                        document.getElementById('loading-spinner').style.display = 'none';
                    } else {
                        document.getElementById('status-desc').textContent = 'Your org has been connected. Closing window...';
                        setTimeout(function() {
                            window.close();
                        }, 800);
                    }
                } else {
                    document.getElementById('status-title').textContent = 'Authentication Complete';
                    document.getElementById('status-desc').textContent = 'Please return to the GenAI chat window.';
                }
            } catch (e) {
                console.error('OAuth callback error:', e);
                document.getElementById('status-title').textContent = 'Callback Processing Error';
                document.getElementById('status-desc').textContent = e.message || 'Unknown error occurred.';
            }
        })();
    </script>
</body>
</html>
</apex:page>
